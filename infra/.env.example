# 실제 값은 VM 위에서만 채운다 (infra/README.md 절차 참고). 이 파일은 자리표시자만.
# Cloud SQL(관리형 Postgres) 전체 접속 URL — 예: postgres://pguser:***@<cloudsql-ip>:5432/posture
DATABASE_URL=postgres://user:change-me@host:5432/posture

# LiveKit Cloud (기본 경로)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit 셀프호스트 (옵트인 경로 + livekit 컨테이너 키)
LIVEKIT_SELF_URL=wss://lk.34-64-158-222.sslip.io
LIVEKIT_SELF_KEY=
LIVEKIT_SELF_SECRET=

